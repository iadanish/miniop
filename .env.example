# MiniOp environment template — replace ALL placeholders with MiniOp-owned credentials.
# DO NOT copy LittleOS credentials (Telegram, Resend, Vercel, Supabase from LittleOS projects).

# --- MiniOp Supabase (required — user provides project ref) ---
SUPABASE_PROJECT_REF=your_miniop_project_ref
SUPABASE_DB_PASSWORD=your_miniop_db_password
SUPABASE_ACCESS_TOKEN=your_supabase_personal_access_token

SUPABASE_STAGING_URL=https://your_miniop_project_ref.supabase.co
SUPABASE_STAGING_ANON_KEY=your_miniop_anon_key
SUPABASE_STAGING_SERVICE_KEY=your_miniop_service_role_key

SUPABASE_PROD_URL=https://your_miniop_project_ref.supabase.co
SUPABASE_PROD_ANON_KEY=your_miniop_anon_key
SUPABASE_PROD_SERVICE_KEY=your_miniop_service_role_key
SUPABASE_SERVICE_ROLE_KEY=your_miniop_service_role_key

NEXT_PUBLIC_SUPABASE_URL=https://your_miniop_project_ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_miniop_anon_key

# --- MiniOp Cloudflare (correct per user) ---
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key
R2_SECRET_ACCESS_KEY=your_r2_secret_key
R2_BUCKET_NAME=miniops
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# --- MiniOp Notion (correct per user) ---
NOTION_API_KEY=your_notion_api_key

# --- MiniOp-owned (NOT LittleOS — user must supply MiniOp credentials) ---
TELEGRAM_BOT_TOKEN=your_miniop_telegram_bot_token
TELEGRAM_CHAT_ID=your_miniop_telegram_chat_id
RESEND_API_KEY=your_miniop_resend_api_key
NOTIFICATION_EMAIL=your_miniop_notification_email
VERCEL_TOKEN=your_miniop_vercel_token